<launch>
  <!-- Load URDF into ROS parameter server -->
  <param name="robot_description" textfile="$(find robot_simulation)/urdf/urdf/car.urdf" />

  <!-- Publish static transforms and joint states for visualization -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen" />

  <!-- Simulation bridge: wheel speed commands -> odometry / joint state -->
  <node pkg="robot_simulation" type="car_speed" name="car_speed" output="screen" />

  <!-- Visualize in RViz -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find robot_simulation)/config/car.rviz" />
</launch>
