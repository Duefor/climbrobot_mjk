<launch>
  <!-- RViz-only visualization driven by robot_main sim mode -->

  <arg name="haptic_tcp_topic" default="/phantom/pose"/>

  <!-- Load URDF + SRDF into robot_description -->
  <include file="$(find cs66_moveit_config)/launch/planning_context.launch">
    <arg name="load_robot_description" value="true"/>
    <arg name="robot_description" value="robot_description"/>
  </include>

  <!-- Publish TF tree from /joint_states -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen" />

  <!-- Visualize -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find robot_simulation)/config/cs66arm.rviz" />

  <!-- Haptic TCP -> mapping -> MoveIt IK -> /joint_states (sim) -->
  <node pkg="robot_set" type="robot_main" name="robot_main" output="screen">
    <param name="use_sim" value="true"/>
    <param name="haptic_tcp_topic" value="$(arg haptic_tcp_topic)"/>
    <param name="sim_joint_states_topic" value="/joint_states"/>

    <!-- Movable workspace mapping (drift为漂移映射，fixed为固定映射，clutch为离合映射) -->
    <param name="map_mode" value="drift"/>
    <param name="h_work_radius" value="0.12"/>
    <param name="h_drift_radius" value="0.16"/>
    <param name="drift_gain" value="10.0"/>
    <param name="drift_speed_max" value="0.05"/>
    <!-- Asymmetric drift box is derived from H_MIN/H_MAX around H_INIT. -->
    <!-- Example (non-symmetric Z): H_INIT_3=-0.06, H_MIN_3=-0.10, H_MAX_3=0.18 -->
    <!-- <param name="H_INIT_3" value="-0.06"/> -->
    <!-- <param name="H_MIN_3" value="-0.10"/> -->
    <!-- <param name="H_MAX_3" value="0.18"/> -->

    <!-- Workspace visualization (sphere) -->
    <param name="workspace_viz_enable" value="true"/>
    <param name="workspace_viz_frame" value="base_link"/>
    <param name="workspace_viz_rate" value="20.0"/>
    <param name="workspace_viz_topic" value="/workspace_window"/>
    <param name="work_box_scale" value="0.8"/>

    <!-- Follow position + orientation -->
    <param name="CONTROL_MODE" value="0"/>

    <!-- Match MoveIt config -->
    <param name="planning_group" value="planning_group"/>
    <param name="tip_link" value="ee_link"/>

    <param name="root_joint_1" value="0.0"/>
    <param name="root_joint_2" value="-1.18"/>
    <param name="root_joint_3" value="-2.44"/>
    <param name="root_joint_4" value="-1.1"/>
    <param name="root_joint_5" value="1.57"/>
    <param name="root_joint_6" value="-1.57"/>
  </node>
</launch>
